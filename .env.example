# ServiceNow MCP Server Configuration
# Rename this file to .env and fill in your instance credentials

# ServiceNow Instance ID (e.g. dev12345) or full URL (e.g. https://yourinstance.service-now.com)
SN_INSTANCE=devXXXXX

# ServiceNow Service Account / Admin User
SN_USER=admin

# ServiceNow Password
SN_PASS=your_secure_password_here

# HTTP Request Timeout in seconds (default: 30.0)
SN_TIMEOUT=30.0

# Verify SSL Certificate (true / false)
SN_VERIFY_SSL=true

# FastMCP Logging Settings
FASTMCP_LOG_LEVEL=CRITICAL
FASTMCP_SHOW_SERVER_BANNER=false
PYTHONIOENCODING=utf-8
